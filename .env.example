# Токен бота от @BotFather, обязателен.
# Файл .env содержит секрет: после создания выполните chmod 600 .env,
# чтобы токен не читали другие пользователи машины.
TELEGRAM_TOKEN=

# Числовой id чата для прогрева inline-кэша file_id (необязательно).
# Без него inline-режим наполняется после первого /meme.
TG_CACHE_CHAT=

# Корень с каталогами music/ и video/ (необязательно).
# По умолчанию ищется в текущем каталоге и в родительском.
BATEK_ROOT=

# Уровень журналов через EnvFilter (необязательно). Примеры:
# RUST_LOG=info
# RUST_LOG=batek_rs_tg=debug
RUST_LOG=info

# Отладочная команда /triggers работает только у пользователя с этим
# числовым id (необязательно). Без переменной команда отвечает, что
# отладка выключена, и ничего не показывает.
TG_DEBUG_USER_ID=

# Числовой id владельца бота для команды /admin (необязательно).
# Без переменной панель управления выключена целиком: ни один пользователь
# её не откроет. Модераторов админ добавляет уже из панели.
TG_ADMIN_USER_ID=
